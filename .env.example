# ─────────────────────────────────────────────
# Base URL de la aplicación (sin barra final)
# Producción: https://mycard.nexus-sales.eu
# Desarrollo: http://localhost:3000
# ─────────────────────────────────────────────
APP_URL=http://localhost:3000

# ─────────────────────────────────────────────
# PostgreSQL (Prisma)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
# Producción: rol mycard_app sobre la base "mycard" del PostgreSQL de Dokploy
# (añadir &sslmode=require si la base está en otro servidor). Ver DEPLOY.md.
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/mycard?schema=public

# ─────────────────────────────────────────────
# Proxies de confianza delante de la app (para la IP del cliente en X-Forwarded-For)
# 1 = solo Traefik (Dokploy). La IP se toma contando desde la derecha.
# ─────────────────────────────────────────────
TRUSTED_PROXY_HOPS=1

# ─────────────────────────────────────────────
# Sesiones
# ─────────────────────────────────────────────
# Nombre de la cookie de sesión
SESSION_COOKIE_NAME=sid
# Duración de la sesión en segundos (default: 7 días)
SESSION_DURATION_SECONDS=604800

# ─────────────────────────────────────────────
# Primer administrador (usado solo por el seed)
# ─────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe1234!
ADMIN_NAME=Admin

# ─────────────────────────────────────────────
# Almacenamiento local de archivos (imágenes)
# Ruta absoluta o relativa al directorio raíz
# ─────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ─────────────────────────────────────────────
# Google Wallet (Pases Digitales)
# ─────────────────────────────────────────────
# ID de Emisor obtenido en Google Pay & Wallet Console
GOOGLE_WALLET_ISSUER_ID=3388000000022345678
# Clave JSON de la cuenta de servicio de Google Cloud, codificada en base64
# Generar con: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service_account.json"))
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii...
