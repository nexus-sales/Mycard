// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  USER
}

enum CardTemplate {
  MINIMAL
  MODERN
  CLASSIC
}

// ─────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(USER)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]
  invites      Invite[]  @relation("CreatedBy")
  usedInvite   Invite?   @relation("UsedBy")
  cards        Card[]

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Invite {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  email       String?
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?   @unique
  createdAt   DateTime  @default(now())

  createdBy   User      @relation("CreatedBy", fields: [createdById], references: [id])
  usedBy      User?     @relation("UsedBy", fields: [usedById], references: [id])

  @@index([tokenHash])
  @@index([createdById])
}

model Card {
  id        String       @id @default(cuid())
  userId    String
  slug      String       @unique
  template  CardTemplate @default(MINIMAL)
  theme     Json         @default("{}")
  active    Boolean      @default(true)
  allowPublicWallet Boolean @default(true)
  views     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   CardContent?

  @@index([slug])
  @@index([userId])
}

model CardContent {
  cardId          String   @id
  name            String   @default("")
  jobTitle        String   @default("")
  company         String   @default("")
  bio             String   @default("")
  phone           String   @default("")
  email           String   @default("")
  website         String   @default("")
  address         String   @default("")
  avatarPath      String?
  bannerPath      String?
  socialLinks     Json     @default("[]")
  // Visibility toggles for sensitive fields
  showPhone       Boolean  @default(false)
  showEmail       Boolean  @default(true)
  showAddress     Boolean  @default(false)

  card            Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
}
